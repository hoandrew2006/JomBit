# Copy this file to .env.local and put your key there. Never share .env.local.
# Create/restrict your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Local Vite safety cap only, reset at UTC midnight or server restart.
# Hosted Vercel scanning does not use this value.
JOMBIT_DAILY_SCAN_LIMIT=25

# Vercel only: server-side variables, NEVER prefix these with VITE_.
JOMBIT_APP_ORIGIN=https://jom-bit-6667.vercel.app
